{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/gateway.js": {
      "includeFiles": "{dist/**,server-runtime/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/gateway?path=/$1"
    }
  ]
}
