{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/gateway.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/gateway?path=/$1"
    }
  ],
  "framework": null
}
